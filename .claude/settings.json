{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest *)",
      "Bash(python -m unittest *)",
      "Bash(python3 scripts/ci_check.py *)",
      "Bash(python3 scripts/public_api.py *)",
      "Bash(python3 consumers/workshop_cli/report_cli.py *)",
      "Bash(python3 .claude/skills/octet-statut-uds/scripts/decode_statut.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "mcp__jira__get_issue",
      "mcp__jira__get_comments",
      "mcp__jira__search_issues"
    ],
    "ask": [
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./config/secrets.env)",
      "Read(*.env)",
      "Edit(/contracts/**)",
      "Bash(git push *)"
    ]
  },
  "enabledMcpjsonServers": [
    "jira"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_paths.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate.py\"",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
